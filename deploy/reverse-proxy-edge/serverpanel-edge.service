[Unit]
Description=ServerPanel connector for public NGINX
After=network-online.target nginx.service
Wants=network-online.target
Requires=nginx.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/serverpanel-edge/edge.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=serverpanel-edge
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=serverpanel-edge
StateDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
